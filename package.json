{
  "name": "dotori-config",
  "private": true,
  "description": "Personal macOS configuration powered by @mokyabun/dotori",
  "type": "module",
  "scripts": {
    "dotori": "bun run main.ts",
    "plan": "bun run main.ts plan",
    "apply": "bun run main.ts apply",
    "clean": "bun run main.ts clean",
    "doctor": "bun run main.ts doctor",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run format:check && bun run lint",
    "format": "oxfmt main.ts config",
    "format:check": "oxfmt --check main.ts config",
    "lint": "oxlint main.ts config",
    "lint:fix": "oxlint --fix main.ts config"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mokyabun/dotori": "^0.1.0"
  }
}
